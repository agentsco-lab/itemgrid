# Gridbay's window: allowed user namespaces, so WebKit's sandbox (bubblewrap)
# can run for the Microsoft sign-in window (Ubuntu 24.04 restricts them for
# unconfined programs). Otherwise unconfined, as GNOME Web's profile.

abi <abi/4.0>,
include <tunables/global>

profile gridbay-gui /{usr/bin,home/*/.local/bin}/gridbay-gui flags=(unconfined) {
  userns,

  include if exists <local/gridbay-gui>
}
